{
  "name": "rd-linkforge",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "mounts": [
    {
      "type": "volume",
      "source": "go-pkg-mod",
      "target": "/go/pkg/mod"
    },
    {
      "type": "volume",
      "source": "go-build-cache",
      "target": "/root/.cache/go-build"
    }
  ],
  "postCreateCommand": "go build ./... && cd pkg && go build ./...",
  "customizations": {
    "vscode": {
      "extensions": ["golang.Go"]
    }
  }
}
